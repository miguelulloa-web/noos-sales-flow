# Server Configuration
PORT=3000
NODE_ENV=development

# Database Persistence (Local SQLite)
DB_DIR=./data
DB_PATH=./data/noos_sales_flow.db

# CSRF / Allowed Origins (comma separated exact origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial Bootstrap Credentials (Required for npm run init-db; do not commit actual passwords)
INITIAL_ADMIN_EMAIL=admin@noosadvisory.com
INITIAL_ADMIN_PASSWORD=
INITIAL_DEMO_EMAIL=operador@noosadvisory.com
INITIAL_DEMO_PASSWORD=

# Google Gemini API Key (Required for TP-02 extraction engine)
GEMINI_API_KEY=
